{
  "name": "@tryabby/vue",
  "version": "0.0.0",
  "description": "Vue integration for Abby",
  "main": "dist/index.js",
  "files": ["dist"],
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
