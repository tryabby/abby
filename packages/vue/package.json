{
  "name": "@tryabby/vue",
  "version": "0.0.1",
  "description": "Vue 3 bindings for Abby",
  "main": "dist/index.js",
  "files": ["dist"],
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/",
    "dev": "tsup src/ --watch",
    "test": "vitest"
  },
  "homepage": "https://docs.tryabby.com",
  "keywords": ["vue", "feature-flags", "ab-testing", "remote-config"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@types/js-cookie": "^3.0.3",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^20.0.3",
    "msw": "^0.49.1",
    "node-fetch": "^3.3.0",
    "tsconfig": "workspace:*",
    "tsup": "^6.5.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5",
    "vue": "^3.4.21"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@tryabby/core": "workspace:*",
    "js-cookie": "^3.0.1"
  }
