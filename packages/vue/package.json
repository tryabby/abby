{
  "name": "@tryabby/vue",
  "version": "7.0.1",
  "description": "Vue integration for Abby",
  "main": "dist/index.js",
  "files": ["dist"],
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/",
    "dev": "pnpm run build --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://docs.tryabby.com",
  "keywords": [
    "abby",
    "vue",
    "nuxt",
    "a/b testing",
    "feature flags",
    "remote config"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tryabby/devtools": "workspace:*",
    "@types/js-cookie": "^3.0.3",
    "@types/node": "22.1.0",
    "@vitejs/plugin-vue": "^5.1.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^20.0.3",
    "msw": "^0.49.1",
    "node-fetch": "^3.3.0",
    "tsconfig": "workspace:*",
    "tsup": "^6.5.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@tryabby/core": "workspace:*",
    "js-cookie": "^3.0.1"
  }
}
