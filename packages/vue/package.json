{
  "name": "@tryabby/vue",
  "version": "0.1.0",
  "description": "Typed Vue composables for Abby feature flags, remote configuration and A/B tests",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsup src/index.ts",
    "dev": "pnpm run build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "vite --host 127.0.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tryabby/core": "workspace:*"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.3",
    "@types/node": "^18.19.0",
    "@vue/server-renderer": "3.5.13",
    "js-cookie": "^3.0.1",
    "jsdom": "^20.0.3",
    "tsup": "^6.5.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5",
    "vue": "3.5.13"
  }
}
